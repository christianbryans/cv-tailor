# --- Pick ONE provider -------------------------------------------------
# Groq: free tier, no credit card. Key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=

# Or Claude (paid API). Key: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: force a provider ("groq" | "claude"). Default: Groq if GROQ_API_KEY is set.
AI_PROVIDER=

# --- Protection --------------------------------------------------------
# Recommended on a public URL. If set, every API call must send this code
# (enter it in Settings in the app).
ACCESS_CODE=
